
import { createClient } from "npm:@supabase/supabase-js@2";

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers":
    "authorization, x-client-info, apikey, content-type",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
};

const reply = (data: unknown, status = 200) =>
  new Response(JSON.stringify(data), {
    status,
    headers: { ...corsHeaders, "Content-Type": "application/json" },
  });

Deno.serve(async (req) => {
  if (req.method === "OPTIONS") {
    return new Response("ok", { headers: corsHeaders });
  }

  if (req.method !== "POST") {
    return reply({ error: "Méthode non autorisée." }, 405);
  }

  try {
    const supabaseUrl = Deno.env.get("SUPABASE_URL")!;
    const serviceKey = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!;
    const waveKey = Deno.env.get("WAVE_API_KEY");
    const successUrl = Deno.env.get("APP_SUCCESS_URL");
    const errorUrl = Deno.env.get("APP_ERROR_URL");

    if (!supabaseUrl || !serviceKey || !waveKey ||
        !successUrl || !errorUrl) {
      return reply({ error: "Configuration serveur incomplète." }, 500);
    }

    if (!successUrl.startsWith("https://") ||
        !errorUrl.startsWith("https://")) {
      return reply({ error: "Les URL doivent utiliser HTTPS." }, 500);
    }

    const authorization = req.headers.get("Authorization") || "";
    const token = authorization.replace(/^Bearer\s+/i, "");

    if (!token || token === authorization) {
      return reply({ error: "Connexion nécessaire." }, 401);
    }

    const supabase = createClient(supabaseUrl, serviceKey, {
      auth: { persistSession: false },
    });

    const { data: authData, error: authError } =
      await supabase.auth.getUser(token);

    if (authError || !authData.user) {
      return reply({ error: "Session utilisateur invalide." }, 401);
    }

    const userId = authData.user.id;

    const { data: profile, error: profileError } = await supabase
      .from("profiles")
      .select("role")
      .eq("id", userId)
      .single();

    if (profileError || profile?.role !== "driver") {
      return reply({ error: "Réservé aux chauffeurs." }, 403);
    }

    const body = await req.json();
    const plan = body.plan_code;

    const plans: Record<string, { amount: number; courses: number }> = {
      START: { amount: 5000, courses: 30 },
      PLUS: { amount: 10000, courses: 60 },
    };

    const selectedPlan = plans[plan];

    if (!selectedPlan) {
      return reply({ error: "Forfait invalide." }, 400);
    }

    const { data: subscription, error: insertError } = await supabase
      .from("driver_subscriptions")
      .insert({
        driver_id: userId,
        plan_code: plan,
        amount_xof: selectedPlan.amount,
        status: "pending",
      })
      .select("id")
      .single();

    if (insertError || !subscription) {
      return reply({ error: "Impossible de créer le paiement." }, 500);
    }

    const waveResponse = await fetch(
      "https://api.wave.com/v1/checkout/sessions",
      {
        method: "POST",
        headers: {
          "Authorization": `Bearer ${waveKey}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          amount: String(selectedPlan.amount),
          currency: "XOF",
          client_reference: subscription.id,
          success_url: successUrl,
          error_url: errorUrl,
        }),
      },
    );

    const waveData = await waveResponse.json();

    if (!waveResponse.ok || !waveData.id || !waveData.wave_launch_url) {
      await supabase
        .from("driver_subscriptions")
        .update({ status: "failed" })
        .eq("id", subscription.id);

      return reply({
        error: "Wave n'a pas pu créer le paiement.",
      }, 502);
    }

    const { error: updateError } = await supabase
      .from("driver_subscriptions")
      .update({ wave_checkout_id: waveData.id })
      .eq("id", subscription.id);

    if (updateError) {
      return reply({
        error: "Paiement créé, mais enregistrement incomplet. Contacte le support.",
      }, 500);
    }

    return reply({
      success: true,
      plan_code: plan,
      amount_xof: selectedPlan.amount,
      courses: selectedPlan.courses,
      checkout_id: waveData.id,
      wave_launch_url: waveData.wave_launch_url,
    });
  } catch (_error) {
    return reply({ error: "Une erreur serveur est survenue." }, 500);
  }
});
